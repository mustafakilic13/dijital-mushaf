+
+  check("kurulan test DOM'unda gerçek Arapça metin sorgulanabilir (jsdom seviyesinde en azından mevcut)", d.querySelector(".text-layer-line").textContent === "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ");
